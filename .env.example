# ManaWG MCP configuration — copy to ~/.config/manawg-mcp/env and chmod 600.
# Never commit real values; this template ships placeholders only.

# ManaWG app (the API the MCP calls)
MANAWG_BASE_URL=https://manawg.example.invalid
# Optional default flat (8-character share code); without it the account's only flat is used.
# MANAWG_WG_CODE=K7Q2M9XD

# Supabase project behind the app — used to build the session the app accepts
MANAWG_SUPABASE_URL=https://your-project.supabase.co
MANAWG_SUPABASE_PUBLISHABLE_KEY=sb_publishable_key_placeholder

# Auth mode: session (default, the server signs in the account below) or oauth (hosted: every
# user signs in through the Supabase OAuth server; needs MANAWG_TRANSPORT=http and
# MANAWG_PUBLIC_URL, and none of the sign-in values below).
# MANAWG_AUTH=oauth
# MANAWG_PUBLIC_URL=https://mcp.manawg.example.invalid/mcp

# Session mode sign-in: either a long-lived refresh token …
MANAWG_SUPABASE_REFRESH_TOKEN=refresh_token_placeholder

# … or an email/password pair for the ManaWG account (delete the line above then)
# MANAWG_EMAIL=member@example.test
# MANAWG_PASSWORD=replace_me

# Optional: register destructive tools (delete/update operations), default off
# MANAWG_ALLOW_DESTRUCTIVE=1

# Optional: session cache location, default ~/.config/manawg-mcp/session.json
# MANAWG_SESSION_CACHE=/Users/you/.config/manawg-mcp/session.json

# Optional: transport, default stdio. Set to http to serve streamable HTTP instead.
# MANAWG_TRANSPORT=http
# MANAWG_HTTP_HOST=0.0.0.0
# MANAWG_HTTP_PORT=8080
# MANAWG_HTTP_PATH=/mcp
# Required if HTTP binds outside loopback. Generate once with `openssl rand -hex 32` and store it
# here so clients can keep using the same key after a restart.
# MANAWG_HTTP_API_KEY=replace_with_a_long_random_token

# Optional: allow browser clients (MCP Inspector) to call the HTTP endpoint, default off.
# MANAWG_HTTP_CORS=1
# Optional: how long /ready reports 503 after SIGTERM before the listener closes (ms, default 5000)
# MANAWG_DRAIN_MS=5000
