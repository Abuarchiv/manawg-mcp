{
  "name": "manawg-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "MCP server for ManaWG, the free, open-source app for shared flats: expenses, cleaning rota, shopping list, calendar and chat as tools for AI assistants",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abuarchiv/manawg-mcp.git"
  },
  "homepage": "https://github.com/Abuarchiv/manawg-mcp#readme",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": "9.x"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "live-check": "node scripts/live-check.mjs",
    "smoke": "node scripts/smoke-stdio.mjs",
    "inspector": "npx -y @modelcontextprotocol/inspector node dist/index.js",
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@modelcontextprotocol/client": "^2",
    "@types/node": "^22.20.5",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2",
    "zod": "^4.6.7"
  }
}
